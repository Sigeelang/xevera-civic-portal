# Xevera SPA .htaccess
# 
# This file is COPIED INTO dist/ by Vite during build.
# It is a SAFETY NET for environments where Apache is configured
# with AllowOverride All. The vhost (deploy/apache/xevera.conf)
# is the PRIMARY handler and is authoritative.
#
# KEY LEARNING: RewriteCond only attaches to the IMMEDIATELY
# following RewriteRule. Each rule below carries its own conditions.

RewriteEngine On

# 1) Pass through API and upload requests
RewriteRule ^api/ - [L]
RewriteRule ^uploads/ - [L]

# 2) Serve existing files/dirs directly (assets, etc.)
# In .htaccess context, %{REQUEST_FILENAME} IS the filesystem path.
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# 3) SPA fallback: serve index.html for everything else
RewriteRule ^ index.html [L]
