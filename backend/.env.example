# Copy to .env and fill in real values. NEVER commit the real .env.
MAIL_ENABLED=1
XEVERA_SMTP_HOST=ssl://smtp.gmail.com
XEVERA_SMTP_PORT=465
XEVERA_SMTP_USER=yourgmail@gmail.com
XEVERA_SMTP_PASS=your_16_char_app_password
XEVERA_SMTP_FROM=yourgmail@gmail.com

DB_HOST=localhost
DB_PORT=3306
DB_NAME=xevera_civic
DB_USER=root
DB_PASS=

APP_NAME=Xevera Portal
APP_URL=http://localhost:5173
APP_KEY=
CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Local file queue for emails that fail SMTP (retried via admin UI or cron).
# Defaults to /var/www/xevera/backend/storage/mail_queue when unset.
# XEVERA_MAIL_QUEUE_DIR=
# Retry triage: items older than this (hours) or failing this many times
# are discarded instead of resent (stale OTPs must not be delivered late).
# XEVERA_MAIL_QUEUE_MAX_AGE_HOURS=48
# XEVERA_MAIL_QUEUE_MAX_ATTEMPTS=5
# Shared secret for the maintenance scheduler (maintenance/sync.php).
# Generate with: openssl rand -hex 32
# Cron must send it as ?secret= or X-Xevera-Cron-Secret header.
XEVERA_MAINTENANCE_CRON_SECRET=
