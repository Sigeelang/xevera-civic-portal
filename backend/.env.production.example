# Xevera Portal production environment template.
# Copy to backend/.env, fill in real values, then:
#   sudo chown apache:apache backend/.env
#   sudo chmod 640 backend/.env
# NEVER commit the real .env.
#
# On a fresh EC2 instance, prefer:
#   sudo bash deploy/configure-env.sh

APP_NAME=Xevera Portal
APP_URL=https://xevera-portal.duckdns.org
# APP_KEY is optional. If it is absent or empty, the app uses /.xevera_secret.
# Do not set a new APP_KEY unless you intend to invalidate existing tokens.
# APP_KEY=

# Comma-separated origins. Include both HTTPS and the legacy HTTP origin.
CORS_ALLOW_ORIGINS=https://xevera-portal.duckdns.org,http://xevera-portal.duckdns.org

# Database: production uses RDS MariaDB.
# For a local MariaDB test deployment, use 127.0.0.1 instead.
DB_HOST=REPLACE_WITH_RDS_ENDPOINT
DB_PORT=3306
DB_NAME=xevera_civic
DB_USER=xevera_app
DB_PASS=REPLACE_WITH_DB_PASSWORD

# Keep application secrets in backend/.env. Do not enable Secrets Manager
# until the xevera/app secret contains valid JSON for this deployment.
AWS_REGION=ap-southeast-1
XEVERA_USE_SECRETS_MANAGER=0

# Email/OTP: Gmail SMTP with a Google App Password.
# Use a 16-character App Password, not the normal Gmail account password.
MAIL_ENABLED=1
MAIL_PROVIDER=smtp
MAIL_FROM=xeveraportal@gmail.com
XEVERA_SMTP_HOST=ssl://smtp.gmail.com
XEVERA_SMTP_PORT=465
XEVERA_SMTP_USER=xeveraportal@gmail.com
XEVERA_SMTP_PASS=REPLACE_WITH_GMAIL_APP_PASSWORD
XEVERA_SMTP_FROM=xeveraportal@gmail.com
XEVERA_SMTP_USE_SECRETS_MANAGER=0

# Optional: Amazon SES alternative.
# MAIL_PROVIDER=smtp
# XEVERA_SMTP_HOST=email-smtp.ap-southeast-1.amazonaws.com
# XEVERA_SMTP_PORT=587
# XEVERA_SMTP_USER=REPLACE_WITH_SES_SMTP_USERNAME
# XEVERA_SMTP_PASS=REPLACE_WITH_SES_SMTP_PASSWORD

# Failed-email queue (defaults to backend/storage/mail_queue).
# XEVERA_MAIL_QUEUE_DIR=/var/www/xevera/backend/storage/mail_queue
# XEVERA_MAIL_QUEUE_MAX_AGE_HOURS=48
# XEVERA_MAIL_QUEUE_MAX_ATTEMPTS=5

# Optional shared secret for maintenance/sync.php. Generate with:
#   openssl rand -hex 32
# XEVERA_MAINTENANCE_CRON_SECRET=

# Never set this in production. It is for controlled test mail routing only.
# XEVERA_MAIL_TEST_OVERRIDE_TO=
