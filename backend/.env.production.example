# Xevera Portal backend secrets - NEVER commit this file.
# This file is the production-ready template for the EC2 instance.
# Local development uses .env.dev or .env.local instead.

# SMTP (SES - sandbox; production access request submitted separately)
MAIL_ENABLED=1
XEVERA_SMTP_HOST=email-smtp.ap-southeast-2.amazonaws.com
XEVERA_SMTP_PORT=587
XEVERA_SMTP_USER=REPLACE_WITH_SES_SMTP_USERNAME
XEVERA_SMTP_PASS=REPLACE_WITH_SES_SMTP_PASSWORD
XEVERA_SMTP_FROM=no-reply@xevera-portal.duckdns.org

# Database (RDS - ap-southeast-2)
DB_HOST=xevera-db.c7u26y0km2w8.ap-southeast-2.rds.amazonaws.com
DB_PORT=3306
DB_NAME=xevera_civic
DB_USER=xevera_admin
DB_PASS=REPLACE_WITH_RDS_MASTER_PASSWORD

# Application
APP_NAME=Xevera Portal
APP_URL=http://xevera-portal.duckdns.org
APP_KEY=REPLACE_WITH_64_HEX_CHARS_FROM_openssl_rand_-hex_32

# Allowed CORS origins (comma separated)
CORS_ALLOW_ORIGINS=http://xevera-portal.duckdns.org

# Shared secret for the maintenance scheduler (maintenance/sync.php).
# Generate with: openssl rand -hex 32. Cron must send it as ?secret=
# or via the X-Xevera-Cron-Secret header, or sync returns 403.
XEVERA_MAINTENANCE_CRON_SECRET=REPLACE_WITH_64_HEX_CHARS_FROM_openssl_rand_-hex_32

# File queue for failed emails (EBS-persisted dir, www-data writable).
# Defaults to /var/www/xevera/backend/storage/mail_queue when unset.
# XEVERA_MAIL_QUEUE_DIR=/var/www/xevera/backend/storage/mail_queue
# Retry triage: items older than this (hours) or failing this many times
# are discarded instead of resent (stale OTPs must not be delivered late).
# XEVERA_MAIL_QUEUE_MAX_AGE_HOURS=48
# XEVERA_MAIL_QUEUE_MAX_ATTEMPTS=5

# Test mail override (set to your personal email during harness runs; clear in prod)
XEVERA_MAIL_TEST_OVERRIDE_TO=your.personal@email.com
